{
  "name": "@mosaic-media/sdui-react",
  "version": "0.22.0",
  "description": "React runtime for the Mosaic SDUI contract: the native primitive vocabulary, the registry, the renderer and the definition expander. It ships no components \u2014 those are data, served by the Platform from the contract.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepare": "npm run build",
    "sync-tokens": "node scripts/sync-tokens.mjs"
  },
  "dependencies": {
    "hls.js": "^1.5.20",
    "jassub": "^2.5.14"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosaic-media/web.git",
    "directory": "packages/sdui-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ]
}
